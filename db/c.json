{
  "id": "c",
  "name": "C",
  "detect": {
    "files": ["*.c", "*.h", "Makefile", "CMakeLists.txt", "configure.ac", "configure"],
    "dirs": []
  },
  "rules": {
    "gitignore": [
      "*.o", "*.a", "*.so", "*.out", "*.exe", "*.dll", "*.dylib",
      "build/", "dist/", ".cache/", "CMakeCache.txt", "CMakeFiles/",
      "cmake_install.cmake", "Makefile", "*.d", "*.i", "*.s",
      "compile_commands.json", ".clangd/", ".ccls-cache/"
    ],
    "dockerignore": ["build/", "*.o", "*.a"],
    "vscode": { "files.exclude": { "build": true, "CMakeFiles": true } }
  }
}
