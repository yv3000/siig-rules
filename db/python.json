{
  "id": "python",
  "name": "Python",
  "detect": {
    "files": ["requirements.txt", "pyproject.toml", "setup.py", "Pipfile", "setup.cfg"],
    "dirs": ["__pycache__", ".venv", "venv"]
  },
  "rules": {
    "gitignore": [
      "__pycache__/",
      "*.py[cod]",
      "*$py.class",
      "*.so",
      ".Python",
      "build/",
      "develop-eggs/",
      "dist/",
      "downloads/",
      "eggs/",
      ".eggs/",
      "lib/",
      "lib64/",
      "parts/",
      "sdist/",
      "var/",
      "wheels/",
      "*.egg-info/",
      ".installed.cfg",
      "*.egg",
      ".venv/",
      "venv/",
      "ENV/",
      ".env",
      "*.log",
      ".mypy_cache/",
      ".pytest_cache/",
      ".coverage",
      "htmlcov/"
    ],
    "dockerignore": [
      "__pycache__/",
      ".venv/",
      "venv/",
      ".env",
      "*.pyc"
    ],
    "vscode": {
      "files.exclude": {
        "__pycache__": true,
        "*.pyc": true
      }
    }
  }
}
