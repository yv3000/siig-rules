{
  "id": "wordpress",
  "name": "WordPress",
  "detect": {
    "files": ["wp-config.php", "wp-config-sample.php", "functions.php", "style.css"],
    "dirs": ["wp-content", "wp-admin", "wp-includes"]
  },
  "rules": {
    "gitignore": [
      "wp-config.php", "wp-content/uploads/", "wp-content/cache/",
      "wp-content/upgrade/", "wp-content/backup-db/",
      "wp-content/blogs.dir/", "wp-content/advanced-cache.php",
      "wp-content/db.php", "wp-content/object-cache.php",
      "sitemap.xml", "sitemap.xml.gz", ".maintenance",
      "*.log", "error_log", "wp-admin/", "wp-includes/"
    ]
  }
}
