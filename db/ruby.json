{
  "id": "ruby",
  "name": "Ruby",
  "detect": {
    "files": ["Gemfile", "Rakefile", ".ruby-version"],
    "dirs": [".bundle"]
  },
  "rules": {
    "gitignore": [
      "*.gem",
      "*.rbc",
      "/.config",
      "/coverage/",
      "/InstalledFiles",
      "/pkg/",
      "/spec/reports/",
      "/test/tmp/",
      "/test/version_tmp/",
      "/tmp/",
      ".bundle/",
      "vendor/bundle",
      "*.log",
      ".env"
    ],
    "dockerignore": [
      ".bundle/",
      "vendor/bundle",
      ".env",
      "*.log"
    ]
  }
}
